+/// Whether to submit one title list per host submission:
+/// `VICTORY_SPLIT_SUBMISSIONS=1` always, `0` never, else after a slow one.
+fn split() -> bool {
+    static MODE: OnceLock<Option<bool>> = OnceLock::new();
+    match MODE.get_or_init(|| match std::env::var("VICTORY_SPLIT_SUBMISSIONS").as_deref() {
+        Ok("1") => Some(true),
+        Ok("0") => Some(false),
+        _ => None,
+    }) {
+        Some(on) => *on,
+        None => SPLIT_LEFT.load(Ordering::Relaxed) > 0,
+    }
+}
+
+/// Notes how long a submission ran on the GPU, for [`split`].
+fn note_submission(gpu: std::time::Duration) {
+    if gpu > SPLIT_AFTER {
+        if SPLIT_LEFT.swap(SPLIT_FOR, Ordering::Relaxed) == 0 {
+            tracing::info!(ms = gpu.as_millis(), "host submissions one list at a time: true");
+        }
+    } else if SPLIT_LEFT
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_sub(1))
+        == Ok(1)
+    {
+        tracing::info!(ms = gpu.as_millis(), "host submissions one list at a time: false");
+    }
+}
