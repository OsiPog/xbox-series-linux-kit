index 0000000..b7823a3
--- /dev/null
+++ b/crates/victory-loader/src/poolmon.rs
@@ -0,0 +1,130 @@
+//! Diagnostic: samples the title's fixed-size object pools (`VICTORY_POOLMON`).
+//!
+//! Some titles keep entities in lock-free pools behind a global pointer:
+//! storage at +0x00, element size at +0x08 (u32), capacity at +0x0c,
+//! live count at +0x10, the tagged free-list head at +0x20, per-slot flag
+//! words at +0x28 and the "in use" flag mask at +0x30. An exhausted pool ends
+//! in the title's own `int3`, so watching their fill level over a run shows
+//! which one leaks and when.
+//!
+//! `VICTORY_POOLMON=<seconds>` turns it on (default 10 s).
+//! `VICTORY_POOLMON_RVAS=name=rva,...` overrides which globals are sampled
+//! (RVAs of the pool-pointer globals in the main image). Once a pool passes
+//! 90 % full, the most common qwords at the first offsets of its live
+//! elements are logged once (archetype/vtable pointers show what leaks).
+
+use std::collections::HashMap;
+use std::time::Duration;
+
+const ENV: &str = "VICTORY_POOLMON";
+const RVAS_ENV: &str = "VICTORY_POOLMON_RVAS";
+
+/// Defaults for the title this was written against.
+const DEFAULT: &[(&str, usize)] = &[
+    ("Building", 0xa9ec938),
+    ("pool_abbe2e8", 0xabbe2e8),
+    ("pool_abbe8c8", 0xabbe8c8),
+    ("pool_abb6918", 0xabb6918),
+];
+
+#[derive(Clone, Copy)]
+struct Pool {
+    storage: usize,
+    size: u32,
+    cap: u32,
+    used: u32,
+    flags: usize,
+    mask: u32,
+}
+
+unsafe fn rd<T: Copy>(addr: usize) -> T {
+    // SAFETY: the caller passes title memory that stays mapped.
+    unsafe { std::ptr::read_volatile(addr as *const T) }
+}
+
+unsafe fn pool(global: usize) -> Option<Pool> {
+    // SAFETY: `global` is inside the main image's data section.
+    let p: usize = unsafe { rd(global) };
+    if p == 0 || p & 7 != 0 {
+        return None;
+    }
+    // SAFETY: a non-null pool pointer the title set up.
+    unsafe {
+        Some(Pool {
+            storage: rd(p),
+            size: rd(p + 8),
+            cap: rd(p + 0xc),
+            used: rd(p + 0x10),
+            flags: rd(p + 0x28),
+            mask: rd(p + 0x30),
+        })
+    }
+}
+
+/// Logs the most common qwords at offsets 0..0x60 of the live elements.
+unsafe fn census(name: &str, p: Pool) {
+    if p.storage == 0 || p.flags == 0 || p.size < 8 {
+        return;
+    }
+    let words = (p.size as usize / 8).min(12);
+    let mut hist: Vec<HashMap<u64, u32>> = vec![HashMap::new(); words];
+    let mut live = 0u32;
+    for i in 0..p.cap as usize {
+        // SAFETY: the flag array holds `cap` words.
+        let f: u32 = unsafe { rd(p.flags + i * 4) };
+        if f & p.mask != p.mask {
+            continue;
+        }
+        live += 1;
+        let e = p.storage + i * p.size as usize;
+        for (w, h) in hist.iter_mut().enumerate() {
+            // SAFETY: inside the element.
+            *h.entry(unsafe { rd::<u64>(e + w * 8) }).or_default() += 1;
+        }
+    }
+    tracing::warn!(pool = name, live, "pool census (top qwords per offset)");
+    for (w, h) in hist.into_iter().enumerate() {
+        let mut v: Vec<_> = h.into_iter().collect();
+        v.sort_by(|a, b| b.1.cmp(&a.1));
+        let top: Vec<String> = v.iter().take(6).map(|(k, n)| format!("{k:#x}x{n}")).collect();
+        tracing::warn!(pool = name, off = format_args!("{:#x}", w * 8), distinct = v.len(), "  {}", top.join(" "));
+    }
+}
+
+/// Starts the sampler for the main image at `base`, if asked for.
+pub(crate) fn start(base: usize) {
+    let Some(v) = std::env::var_os(ENV) else { return };
+    let secs = v.to_str().and_then(|s| s.parse().ok()).unwrap_or(10u64).max(1);
+    let pools: Vec<(String, usize)> = match std::env::var(RVAS_ENV) {
+        Ok(s) => s
+            .split(',')
+            .filter_map(|e| {
+                let (n, r) = e.split_once('=')?;
+                Some((n.to_owned(), usize::from_str_radix(r.trim_start_matches("0x"), 16).ok()?))
+            })
+            .collect(),
+        Err(_) => DEFAULT.iter().map(|(n, r)| ((*n).to_owned(), *r)).collect(),
+    };
+    tracing::info!(secs, n = pools.len(), "pool monitor on");
+    let _ = std::thread::Builder::new().name("victory-poolmon".into()).spawn(move || {
+        let mut censused = vec![false; pools.len()];
+        let mut last = vec![u32::MAX; pools.len()];
+        loop {
+            std::thread::sleep(Duration::from_secs(secs));
+            let mut line = String::new();
+            for (i, (name, rva)) in pools.iter().enumerate() {
+                // SAFETY: an RVA inside the mapped main image.
+                let Some(p) = (unsafe { pool(base + rva) }) else { continue };
+                let d = if last[i] == u32::MAX { 0 } else { i64::from(p.used) - i64::from(last[i]) };
+                last[i] = p.used;
+                line += &format!(" {name}={}/{}({d:+})", p.used, p.cap);
+                if !censused[i] && p.cap > 0 && u64::from(p.used) * 10 >= u64::from(p.cap) * 9 {
+                    censused[i] = true;
+                    // SAFETY: pool memory of the running title.
+                    unsafe { census(name, p) };
+                }
+            }
+            tracing::info!("poolmon{line}");
+        }
+    });
+}
