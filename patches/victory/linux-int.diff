+    fn propagate(&mut self, all: &mut Vec<(Bool, bool)>) -> Option<bool> {
+        loop {
+            let mut i = 0;
+            while i < all.len() {
+                let (b, holds) = all[i];
+                if b == if holds { Bool::FALSE } else { Bool::TRUE } {
+                    return Some(false);
