+/// The structure stride of a buffer view (`StructureByteStride`); 0 for a
+/// raw, typed or texture view.
+fn view_stride(view: &View) -> u32 {
+    const BUFFER: u32 = 1;
+    // Shader resource views: the stride is word 7, unordered access views
+    // word 5 (the D3D12 descriptions' layout).
+    let (words, at): (&[u32], usize) = match view {
+        View::Shader(_, Some(w)) => (w, 7),
+        View::Unordered(_, _, Some(w)) => (w, 5),
+        View::Placed(false, _, w) => (w, 7),
+        View::Placed(true, _, w) => (w, 5),
+        _ => return 0,
+    };
+    if words[1] == BUFFER { words[at] } else { 0 }
+}
