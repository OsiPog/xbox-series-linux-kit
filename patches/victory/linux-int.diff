+    use std::sync::atomic::Ordering::Relaxed;
+    let (.., n) = show_spec()?;
+    let shown = std::mem::take(&mut *SHOWN.lock().unwrap_or_else(|e| e.into_inner()));
+    let (_, copy) = shown.into_iter().nth(n - 1)?;
+    let state = copy.state.load(Relaxed);
+    Some((copy, state))
+}
