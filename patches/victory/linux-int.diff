+    let shader = build_with(WATERFALL_SIZE_ONLY_WAVE32, false, 0);
+    let (a, b) = ([[0.0f32; 4]; 8 * 4], [[0.0f32; 4]; 4 * 2]);
+    let views = [
+        View::Texture(8, 4, &a),
+        View::Texture(4, 2, &b),
+        View::RawUav(32),
