+struct Meet<'a> {
+    bools: &'a Bools,
+    extra: Vec<(u32, Bool, Bool)>,
+    extra_unique: Map<(u32, Bool, Bool), Bool>,
+    restrict_memo: Map<Bool, Bool>,
+    forced: Map<u32, bool>,
+    failed: HashSet<Vec<(Bool, bool)>, BuildHasherDefault<Fx>>,
+    budget: usize,
+    overflow: bool,
