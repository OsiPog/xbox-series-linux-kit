+    };
+    let lane = lane_of(lane)?;
+    let mut defs: HashMap<Value, (usize, usize)> = HashMap::new();
+    let mut phis: HashMap<Value, (usize, usize)> = HashMap::new();
+    for (b, block) in p.blocks.iter().enumerate() {
+        for (i, phi) in block.phis.iter().enumerate() {
+            phis.insert(phi.value, (b, i));
+        }
+        for (i, inst) in block.insts.iter().enumerate() {
+            for &(_, w) in &inst.writes {
+                defs.insert(w, (b, i));
+            }
+        }
+    }
+    fn walk(
+        p: &Program,
+        defs: &HashMap<Value, (usize, usize)>,
+        phis: &HashMap<Value, (usize, usize)>,
+        v: Value,
+        lane: u32,
+        seen: &mut Vec<Value>,
+    ) -> Result<Option<Moved>, ()> {
+        if let Some(&(b, i)) = phis.get(&v) {
+            if seen.contains(&v) {
+                return Ok(None);
+            }
+            seen.push(v);
+            let mut found = None;
+            for &a in &p.blocks[b].phis[i].args {
+                if let Some(m) = walk(p, defs, phis, a, lane, seen)? {
+                    if found.is_some_and(|f| f != m) {
+                        return Err(());
+                    }
+                    found = Some(m);
+                }
+            }
+            return Ok(found);
+        }
+        let &(b, i) = defs.get(&v).ok_or(())?;
+        let inst = &p.blocks[b].insts[i];
+        let Fields::Valu(w) = &inst.fields else {
+            return Err(());
+        };
+        let (Some(Operand::Vector { reg, .. }), [value, at]) = (w.dst, &w.src[..]) else {
+            return Err(());
+        };
+        if inst.name() != "v_writelane_b32" {
+            return Err(());
+        }
+        if lane_of(*at).ok_or(())? != lane {
+            return walk(p, defs, phis, inst.read(Reg::V(reg)).ok_or(())?, lane, seen);
+        }
+        match *value {
+            Operand::Scalar { code, .. } if code != NULL => {
+                inst.read(Reg::S(code)).map(Moved::Value)
+            }
+            Operand::Literal(x) => Some(Moved::Const(x)),
+            Operand::Const(c) => inline(c).map(Moved::Const),
+            _ => None,
+        }
+        .map(Some)
+        .ok_or(())
+    }
+    walk(p, &defs, &phis, readlane.read(Reg::V(reg))?, lane, &mut Vec::new())
+        .ok()
+        .flatten()
+}
