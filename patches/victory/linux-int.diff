new file mode 100644
index 0000000..c9dc4c6
--- /dev/null
+++ b/crates/victory-gpu/src/zero.rs
@@ -0,0 +1,328 @@
+//! Zero-copy title memory: the host GPU reads and writes title memory in
+//! place, through a heap made over it (`ID3D12Device13::
+//! OpenExistingHeapFromAddress1`, which vkd3d-proton turns into
+//! `VK_EXT_external_memory_host`), instead of a host copy that submissions
+//! refresh and copy back ([`crate::shadow`]).
+//!
+//! Under Wine on RADV the kernel's user-pointer import needs:
+//! - memory that is not only anonymous: the title's physical pages are
+//!   section views (memfd), which RADV's import refuses unless the zcshim
+//!   preload (`AMDGPU_GEM_USERPTR_ANONONLY` dropped) is loaded; without it
+//!   vkd3d-proton silently gives an unrelated allocation instead, so a
+//!   self-test decides whether this path is used at all;
+//! - every page of the range mapped and writable at every submission: a hole
+//!   or a read-only page makes the kernel reject the whole submission. So
+//!   only view memory is imported (write-watched memory is made read-only by
+//!   Wine's write watching), the copy guards of [`crate::watch`] leave
+//!   imported blocks alone, and xmem fills pages the title unmaps inside an
+//!   imported range with scratch pages ([`title_memory_imported`],
+//!   [`set_hole_filler`]). The brief hole while a view is replaced is
+//!   covered by zcshim resubmitting a rejected submission.
+//!
+//! `VICTORY_ZERO_COPY=0` turns it off.
+//!
+//! shortcut: memory the title releases (rather than unmaps) under a live
+//! imported range would fail every later submission; the title's GPU heaps
+//! live as long as the process.
+
+use std::collections::BTreeMap;
+use std::ffi::c_void;
+use std::sync::{Arc, Mutex, OnceLock, Weak};
+
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::{DXGI_FORMAT_UNKNOWN, DXGI_SAMPLE_DESC};
+use windows::core::Interface;
+
+use crate::host::Host;
+
+/// The unit imported ranges are aligned to (the console's page; the host's
+/// import alignment is 4 KiB).
+const PAGE: usize = 64 << 10;
+
+/// Title memory the host GPU reaches in place.
+pub(crate) struct Region {
+    _heap: ID3D12Heap,
+    pub(crate) buffer: ID3D12Resource,
+    pub(crate) gpu: u64,
+    pub(crate) start: usize,
+    pub(crate) end: usize,
+}
+
+// SAFETY: D3D12 heaps and resources are free-threaded.
+unsafe impl Send for Region {}
+// SAFETY: as above.
+unsafe impl Sync for Region {}
+
+/// Imported regions by start; they live while host copies use them.
+static REGIONS: Mutex<BTreeMap<usize, Weak<Region>>> = Mutex::new(BTreeMap::new());
+
+/// xmem's: maps scratch pages over the unmapped physical-page addresses of
+/// a range; false if it could not.
+static FILLER: OnceLock<fn(usize, usize) -> bool> = OnceLock::new();
+
+/// The runtime's hole filler (see the module notes).
+pub fn set_hole_filler(fill: fn(usize, usize) -> bool) {
+    let _ = FILLER.set(fill);
+}
+
+/// Whether the host GPU reaches part of `[at, at + len)` in place: the
+/// runtime then keeps it mapped (scratch pages where the title unmaps).
+pub fn title_memory_imported(at: usize, len: usize) -> bool {
+    let end = at.saturating_add(len);
+    let regions = REGIONS.lock().unwrap_or_else(|e| e.into_inner());
+    regions
+        .range(..end)
+        .any(|(&start, r)| start < end && r.upgrade().is_some_and(|r| r.end > at))
+}
+
+/// Whether we run under Wine (its ntdll exports `wine_get_version`).
+fn on_wine() -> bool {
+    use windows_sys::Win32::System::LibraryLoader::{GetModuleHandleA, GetProcAddress};
+    // SAFETY: plain lookups in ntdll, always loaded.
+    unsafe {
+        let ntdll = GetModuleHandleA(c"ntdll.dll".as_ptr().cast());
+        !ntdll.is_null() && GetProcAddress(ntdll, c"wine_get_version".as_ptr().cast()).is_some()
+    }
+}
+
+/// Whether title memory is reached in place: asked, on Wine, and the
+/// self-test passed.
+pub(crate) fn enabled(host: &Host) -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        if std::env::var("VICTORY_ZERO_COPY").as_deref() == Ok("0") || !on_wine() {
+            return false;
+        }
+        let ok = self_test(host);
+        if ok {
+            tracing::info!("zero-copy title memory on (view memory imported in place)");
+        } else {
+            tracing::warn!(
+                "zero-copy title memory off: the host GPU does not see imported view memory \
+                 (run with LD_PRELOAD=zcshim.so)"
+            );
+        }
+        ok
+    })
+}
+
+fn buffer_desc(len: u64) -> D3D12_RESOURCE_DESC {
+    D3D12_RESOURCE_DESC {
+        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+        Alignment: 0,
+        Width: len,
+        Height: 1,
+        DepthOrArraySize: 1,
+        MipLevels: 1,
+        Format: DXGI_FORMAT_UNKNOWN,
+        SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+        Flags: D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS
+            | D3D12_RESOURCE_FLAG_ALLOW_CROSS_ADAPTER,
+    }
+}
+
+/// A heap over `[start, end)` and a buffer over all of it.
+fn open(host: &Host, start: usize, end: usize) -> Option<Region> {
+    // SAFETY: the range is committed read-write memory (checked by callers).
+    unsafe {
+        let device: ID3D12Device13 = host.device.cast().ok()?;
+        let heap: ID3D12Heap = device
+            .OpenExistingHeapFromAddress1(start as *const c_void, end - start)
+            .inspect_err(|e| tracing::warn!(error = %e, start = format_args!("{start:#x}"), len = end - start, "title memory import failed"))
+            .ok()?;
+        let mut buffer: Option<ID3D12Resource> = None;
+        host.device
+            .CreatePlacedResource(
+                &heap,
+                0,
+                &buffer_desc((end - start) as u64),
+                D3D12_RESOURCE_STATE_COMMON,
+                None,
+                &mut buffer,
+            )
+            .inspect_err(|e| tracing::warn!(error = %e, "no buffer over imported title memory"))
+            .ok()?;
+        let buffer = buffer?;
+        let gpu = buffer.GetGPUVirtualAddress();
+        crate::host::name(&buffer, || format!("title memory in place {start:#x}+{:#x}", end - start));
+        Some(Region { _heap: heap, buffer, gpu, start, end })
+    }
+}
+
+/// Imports a 64 KiB view of a fresh section and has the GPU copy it out:
+/// whether what it read is what the CPU wrote.
+fn self_test(host: &Host) -> bool {
+    use windows_sys::Win32::Foundation::{CloseHandle, INVALID_HANDLE_VALUE};
+    use windows_sys::Win32::System::Memory::{
+        CreateFileMappingW, FILE_MAP_WRITE, MEMORY_MAPPED_VIEW_ADDRESS, MapViewOfFile,
+        PAGE_READWRITE, SEC_COMMIT, UnmapViewOfFile,
+    };
+    // SAFETY: a section and view of our own, released below.
+    let (section, view) = unsafe {
+        let section = CreateFileMappingW(
+            INVALID_HANDLE_VALUE,
+            std::ptr::null(),
+            PAGE_READWRITE | SEC_COMMIT,
+            0,
+            PAGE as u32,
+            std::ptr::null(),
+        );
+        if section.is_null() {
+            return false;
+        }
+        (section, MapViewOfFile(section, FILE_MAP_WRITE, 0, 0, PAGE).Value as *mut u32)
+    };
+    let release = || {
+        // SAFETY: ours.
+        unsafe {
+            UnmapViewOfFile(MEMORY_MAPPED_VIEW_ADDRESS { Value: view.cast() });
+            CloseHandle(section);
+        }
+    };
+    if view.is_null() {
+        release();
+        return false;
+    }
+    let pattern = |i: usize| (i as u32).wrapping_mul(2654435761) ^ 0x5a17_c0de;
+    for i in 0..PAGE / 4 {
+        // SAFETY: inside the view.
+        unsafe { view.add(i).write(pattern(i)) };
+    }
+    let ok = (|| {
+        let region = open(host, view as usize, view as usize + PAGE)?;
+        let readback = host.readback_buffer(PAGE as u64)?;
+        let list = host.new_list().ok()?;
+        // SAFETY: an open list, live buffers of the copied size.
+        unsafe {
+            list.list.CopyBufferRegion(&readback.0, 0, &region.buffer, 0, PAGE as u64);
+        }
+        list.close();
+        host.execute(&[&list]);
+        let data = readback.1.cast::<u32>();
+        // SAFETY: the read-back buffer's mapping, the GPU done with it.
+        let same = (0..PAGE / 4).all(|i| unsafe { data.add(i).read() } == pattern(i));
+        Some(same)
+    })()
+    .unwrap_or(false);
+    release();
+    ok
+}
+
+/// Every page of `[start, end)` is committed read-write view memory, after
+/// filling unmapped physical pages; read-only blocks are our copy guards,
+/// which the caller opens.
+fn mapped(start: usize, end: usize) -> bool {
+    use windows_sys::Win32::System::Memory::{
+        MEM_COMMIT, MEM_MAPPED, MEM_RESERVE, MEMORY_BASIC_INFORMATION, PAGE_READONLY,
+        PAGE_READWRITE, VirtualQuery,
+    };
+    let mut at = start;
+    let mut filled = false;
+    while at < end {
+        // SAFETY: plain data filled in by the query.
+        let mut info: MEMORY_BASIC_INFORMATION = unsafe { std::mem::zeroed() };
+        // SAFETY: a valid out pointer of the right size.
+        if unsafe { VirtualQuery(at as *const _, &mut info, size_of_val(&info)) } == 0 {
+            return false;
+        }
+        let next = (info.BaseAddress as usize + info.RegionSize).min(end);
+        if info.State == MEM_RESERVE && !filled {
+            // An unmapped stretch of physical-page addresses: scratch pages
+            // there, then look again from the start.
+            match FILLER.get() {
+                Some(fill) if fill(start, end - start) => {
+                    filled = true;
+                    at = start;
+                    continue;
+                }
+                _ => return false,
+            }
+        }
+        if info.State != MEM_COMMIT
+            || info.Type != MEM_MAPPED
+            || !(info.Protect == PAGE_READWRITE || info.Protect == PAGE_READONLY)
+        {
+            return false;
+        }
+        at = next;
+    }
+    true
+}
+
+/// Ranges smaller than this are not imported (unless inside a region):
+/// every imported byte costs every submission (~7.5 ms per GiB), and with
+/// lists submitted one at a time a frame has hundreds; only the world's GPU
+/// heap (174 MB, copied once per list otherwise) pays for that.
+const MIN_IMPORT: usize = 128 << 20;
+/// At most this much title memory is imported at once.
+const MAX_IMPORTED: usize = 256 << 20;
+/// Title memory imported now.
+static IMPORTED: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+impl Drop for Region {
+    fn drop(&mut self) {
+        IMPORTED.fetch_sub(self.end - self.start, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+
+/// The region through which the host GPU reaches `[address, address +
+/// len)` in place, made if needed; `None` if it cannot (not view memory,
+/// not mapped, refused).
+pub(crate) fn region(host: &Host, address: usize, len: usize) -> Option<Arc<Region>> {
+    if !enabled(host) {
+        return None;
+    }
+    let start = address & !(PAGE - 1);
+    let end = address.checked_add(len.max(1))?.next_multiple_of(PAGE);
+    let mut regions = REGIONS.lock().unwrap_or_else(|e| e.into_inner());
+    regions.retain(|_, r| r.strong_count() > 0);
+    if let Some(r) = regions
+        .range(..=start)
+        .rev()
+        .filter_map(|(_, r)| r.upgrade())
+        .find(|r| r.start <= start && end <= r.end)
+    {
+        return Some(r);
+    }
+    // Every submission revalidates all imported memory in the kernel (RADV
+    // lists every allocation in every submission): ~7.5 ms per GiB per
+    // submission here, so 4 GiB of small windows cost more than their
+    // copies. Only big buffers (the world's GPU heap) are worth it; smaller
+    // ones inside an imported region use it above.
+    if end - start < MIN_IMPORT {
+        return None;
+    }
+    let total = IMPORTED.load(std::sync::atomic::Ordering::Relaxed);
+    if total + (end - start) > MAX_IMPORTED {
+        return None;
+    }
+    drop(regions);
+    if !mapped(start, end) {
+        return None;
+    }
+    // No copy guard may stay on it, nor come later.
+    crate::watch::importing(start, end);
+    if !mapped(start, end) {
+        crate::watch::not_imported(start, end);
+        return None;
+    }
+    let started = std::time::Instant::now();
+    let Some(region) = open(host, start, end) else {
+        crate::watch::not_imported(start, end);
+        return None;
+    };
+    tracing::info!(
+        start = format_args!("{start:#x}"),
+        len = end - start,
+        ms = started.elapsed().as_millis(),
+        "title memory reached in place"
+    );
+    IMPORTED.fetch_add(end - start, std::sync::atomic::Ordering::Relaxed);
+    let region = Arc::new(region);
+    REGIONS
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(start, Arc::downgrade(&region));
+    Some(region)
+}
