+fn constant_words(src: &Source) -> Option<Vec<u32>> {
+    match src {
+        Source::Constant(w) => Some(w.clone()),
+        Source::Phi { args, .. } | Source::Select { args, .. } => {
+            let mut words = args.iter().map(constant_words);
+            let first = words.next()??;
+            words.all(|w| w.as_ref() == Some(&first)).then_some(first)
+        }
+        _ => None,
+    }
