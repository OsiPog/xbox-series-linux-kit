diff --git a/apps/victory/src/warm.rs b/apps/victory/src/warm.rs
new file mode 100644
index 0000000..9069594
--- /dev/null
+++ b/apps/victory/src/warm.rs
@@ -0,0 +1,83 @@
+//! `victory warm`: every shader container found goes through the same
+//! translation and disk cache as at run time, so a run finds its shaders
+//! translated instead of translating them while the title waits. Entries
+//! are keyed by this executable, so warm with the build you run.
+
+use std::collections::HashSet;
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Instant;
+
+use anyhow::Result;
+
+use crate::shader::{MAX_FILE, sources};
+
+pub fn run(paths: Vec<PathBuf>, jobs: Option<usize>) -> Result<()> {
+    let paths = crate::default_paths(paths)?;
+    let cfg = victory_core::Config::load()?;
+    let dir = cfg.cache_subdir("shaders")?;
+    println!("cache        {}", dir.display());
+    victory_gpu::shader_cache::use_shader_cache(dir);
+    let threads =
+        jobs.unwrap_or_else(|| std::thread::available_parallelism().map_or(4, |n| n.get()));
+    let seen = Mutex::new(HashSet::new());
+    let (hit, made, failed, dup) = (
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+    );
+    let start = Instant::now();
+    for root in &paths {
+        for entry in walkdir::WalkDir::new(root).into_iter().filter_map(Result::ok) {
+            if !entry.file_type().is_file() || entry.metadata().map_or(0, |m| m.len()) > MAX_FILE {
+                continue;
+            }
+            let Ok(data) = std::fs::read(entry.path()) else { continue };
+            let jobs = sources(&data);
+            if jobs.is_empty() {
+                continue;
+            }
+            let next = AtomicUsize::new(0);
+            std::thread::scope(|s| {
+                for _ in 0..threads.min(jobs.len()) {
+                    s.spawn(|| {
+                        while let Some(job) = jobs.get(next.fetch_add(1, Ordering::Relaxed)) {
+                            let Some(bytes) = job.bytes() else { continue };
+                            if !seen.lock().unwrap_or_else(|e| e.into_inner()).insert(blake3::hash(&bytes)) {
+                                dup.fetch_add(1, Ordering::Relaxed);
+                                continue;
+                            }
+                            let n = match victory_gpu::shader_cache::warm(&bytes) {
+                                Ok(true) => &hit,
+                                Ok(false) => &made,
+                                Err(_) => &failed,
+                            };
+                            let done = n.fetch_add(1, Ordering::Relaxed);
+                            if (done + 1) % 1000 == 0 {
+                                eprintln!(
+                                    "  {:>6.0}s  {} cached, {} translated, {} failed",
+                                    start.elapsed().as_secs_f64(),
+                                    hit.load(Ordering::Relaxed),
+                                    made.load(Ordering::Relaxed),
+                                    failed.load(Ordering::Relaxed)
+                                );
+                            }
+                        }
+                    });
+                }
+            });
+            println!("{}: {} containers", entry.path().display(), jobs.len());
+        }
+    }
+    println!(
+        "warm         {} already cached, {} translated now, {} not translatable, {} duplicates, {:.0} s",
+        hit.into_inner(),
+        made.into_inner(),
+        failed.into_inner(),
+        dup.into_inner(),
+        start.elapsed().as_secs_f64()
+    );
+    Ok(())
+}
