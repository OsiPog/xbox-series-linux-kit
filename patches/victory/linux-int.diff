+        if lo == hi {
+            return lo;
+        }
+        if let Some(&b) = self.bools.unique.get(&(v, lo, hi)) {
+            return b;
+        }
+        if let Some(&b) = self.extra_unique.get(&(v, lo, hi)) {
+            return b;
