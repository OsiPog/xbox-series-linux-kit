+//! Non-Windows stand-ins: validation and pipelines are unavailable.
+use std::path::{Path, PathBuf};
+use victory_shader::emit::HostShader;
+pub struct Validator;
+impl Validator {
+    pub fn default_path() -> Option<PathBuf> { None }
+    pub fn load(_: Option<&Path>) -> Result<Self, String> { Err("validator needs Windows".into()) }
+    pub fn validate(&mut self, _: &mut Vec<u8>) -> Result<(), String> { Ok(()) }
+}
+pub struct Host;
+impl Host {
+    pub fn new(_: bool) -> Result<Self, String> { Err("host D3D12 needs Windows".into()) }
+    pub fn pipeline(&self, _: &HostShader, _: &HostShader) -> Result<(), String> { Ok(()) }
+    pub fn mesh_pipeline(&self, _: &HostShader, _: &HostShader) -> Result<(), String> { Ok(()) }
+    pub fn compute_pipeline(&self, _: &HostShader) -> Result<(), String> { Ok(()) }
+}
+pub mod host {
+    use super::HostShader;
+    pub fn stub_ps() -> HostShader { unreachable!() }
+    pub fn stub_vs(_: &HostShader) -> Result<HostShader, String> { Err("no host".into()) }
+}
