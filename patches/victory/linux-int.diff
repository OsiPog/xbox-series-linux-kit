+            index: t,
+            kind: 16,
+            comp: 9,
+            interp: 0,
+            row: Some(t),
+            col: 0,
+            cols: 4,
+            usage: 0b1111,
+            half: false,
+        })
+        .collect();
+    s.m.terminate(b, Term::Ret);
